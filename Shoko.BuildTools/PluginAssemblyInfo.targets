<Project>
  <!--
    This targets file is used by Shoko.BuildTools during plugin builds.
    It injects the generated assembly metadata file into the compilation.
    The tool passes this file via -p:CustomBeforeMicrosoftCSharpTargets=...
  -->
  <Target Name="_ShokoBuildIncludeAssemblyInfo" BeforeTargets="CoreCompile"
          Condition="'$(ShokoBuildAssemblyInfoFile)' != '' and Exists('$(ShokoBuildAssemblyInfoFile)')">
    <ItemGroup>
      <Compile Include="$(ShokoBuildAssemblyInfoFile)" />
    </ItemGroup>
  </Target>

  <!--
    Hooks around the manifest write, run by Shoko.BuildTools without building
    again: ShokoBeforeAssetWrite once per runtime on its built project, then
    ShokoBeforeReleaseWrite and, after the write, ShokoAfterReleaseWrite once
    per release on the project without a runtime. Attach with AfterTargets or
    through the DependsOn property. See the README's "Manifest hooks".
  -->
  <Target Name="ShokoBeforeAssetWrite" DependsOnTargets="$(ShokoBeforeAssetWriteDependsOn)" />

  <Target Name="ShokoBeforeReleaseWrite" DependsOnTargets="$(ShokoBeforeReleaseWriteDependsOn)" />

  <Target Name="ShokoAfterReleaseWrite" DependsOnTargets="$(ShokoAfterReleaseWriteDependsOn)" />
</Project>

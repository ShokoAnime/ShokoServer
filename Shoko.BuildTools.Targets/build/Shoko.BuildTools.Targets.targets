<Project>
  <!--
    Shoko.BuildTools.Targets — Auto-imported targets for Shoko plugins.
    Injects assembly metadata from manifest.json and git at build time.
    PluginID, PluginName, PluginOverview and PluginTags override what the
    manifest or the source says. The dependencies come from the project alone,
    as PluginDependency items or the PluginDependencies property, which wins
    when both are set:

      <PluginDependency Include="<plugin id>" Version=">=1.0.0" Optional="true" />

    A project setting PluginGenerateClass to true gets its IPlugin class
    generated: a partial class named PluginClassName (Plugin by default) in
    RootNamespace, reading its identity from the assembly. PluginIcon and
    PluginThumbnail name the image files to embed for the server to show.

    A build that imports these targets from source rather than from the
    package points ShokoBuildToolsTasksAssembly at the tasks it built, names
    the targets that put them there in ShokoBuildToolsPrepareTargets, and
    sets ShokoBuildToolsUseTaskHost so the tasks run out of process and no
    build node keeps an old copy of them loaded.
  -->

  <PropertyGroup>
    <ShokoBuildToolsTasksAssembly Condition="'$(ShokoBuildToolsTasksAssembly)' == ''">$(MSBuildThisFileDirectory)..\lib\net10.0\Shoko.BuildTools.Tasks.dll</ShokoBuildToolsTasksAssembly>
  </PropertyGroup>

  <!--
    A build shoko-build drives (it sets ShokoBuildAssemblyInfoFile) gets the
    runtime identifier, the plugin's identity, tags, dependencies and git
    metadata from shoko-build's own generated file. Stamping them here too would
    write each key twice, and the server keeps the first: shoko-build's tags,
    which add the discovered ones to PluginTags, would lose to these.
  -->

  <!-- RuntimeIdentifier — explicit RID or "any" for portable libraries -->
  <ItemGroup Condition="'$(ShokoBuildAssemblyInfoFile)' == ''">
    <AssemblyMetadata Include="RuntimeIdentifier" Value="$(RuntimeIdentifier)" Condition="'$(RuntimeIdentifier)' != ''" />
    <AssemblyMetadata Include="RuntimeIdentifier" Value="any" Condition="'$(RuntimeIdentifier)' == ''" />
  </ItemGroup>

  <!-- The tasks: in process from the package, out of process when built from source -->
  <UsingTask TaskName="Shoko.BuildTools.Tasks.ReadPluginManifest" AssemblyFile="$(ShokoBuildToolsTasksAssembly)"
             Condition="'$(ShokoBuildToolsUseTaskHost)' != 'true'" />
  <UsingTask TaskName="Shoko.BuildTools.Tasks.ReadPluginManifest" AssemblyFile="$(ShokoBuildToolsTasksAssembly)" TaskFactory="TaskHostFactory"
             Condition="'$(ShokoBuildToolsUseTaskHost)' == 'true'" />
  <UsingTask TaskName="Shoko.BuildTools.Tasks.ReadPluginIdentityFromSource" AssemblyFile="$(ShokoBuildToolsTasksAssembly)"
             Condition="'$(ShokoBuildToolsUseTaskHost)' != 'true'" />
  <UsingTask TaskName="Shoko.BuildTools.Tasks.ReadPluginIdentityFromSource" AssemblyFile="$(ShokoBuildToolsTasksAssembly)" TaskFactory="TaskHostFactory"
             Condition="'$(ShokoBuildToolsUseTaskHost)' == 'true'" />
  <UsingTask TaskName="Shoko.BuildTools.Tasks.GeneratePluginClass" AssemblyFile="$(ShokoBuildToolsTasksAssembly)"
             Condition="'$(ShokoBuildToolsUseTaskHost)' != 'true'" />
  <UsingTask TaskName="Shoko.BuildTools.Tasks.GeneratePluginClass" AssemblyFile="$(ShokoBuildToolsTasksAssembly)" TaskFactory="TaskHostFactory"
             Condition="'$(ShokoBuildToolsUseTaskHost)' == 'true'" />
  <UsingTask TaskName="Shoko.BuildTools.Tasks.AppendReleaseChannel" AssemblyFile="$(ShokoBuildToolsTasksAssembly)"
             Condition="'$(ShokoBuildToolsUseTaskHost)' != 'true'" />
  <UsingTask TaskName="Shoko.BuildTools.Tasks.AppendReleaseChannel" AssemblyFile="$(ShokoBuildToolsTasksAssembly)" TaskFactory="TaskHostFactory"
             Condition="'$(ShokoBuildToolsUseTaskHost)' == 'true'" />
  <UsingTask TaskName="Shoko.BuildTools.Tasks.StampGitMetadata" AssemblyFile="$(ShokoBuildToolsTasksAssembly)"
             Condition="'$(ShokoBuildToolsUseTaskHost)' != 'true'" />
  <UsingTask TaskName="Shoko.BuildTools.Tasks.StampGitMetadata" AssemblyFile="$(ShokoBuildToolsTasksAssembly)" TaskFactory="TaskHostFactory"
             Condition="'$(ShokoBuildToolsUseTaskHost)' == 'true'" />

  <!-- Manifest metadata — generate .cs from manifest.json -->
  <Target Name="_ShokoStampManifestMetadata" BeforeTargets="CoreGenerateAssemblyInfo" DependsOnTargets="$(ShokoBuildToolsPrepareTargets)"
          Condition="'$(ShokoBuildAssemblyInfoFile)' == '' And (Exists('$(MSBuildProjectDirectory)\manifest.json') or Exists('$(MSBuildProjectDirectory)\..\manifest.json'))">
    <ReadPluginManifest ProjectDir="$(MSBuildProjectDirectory)"
                        OutputPath="$(IntermediateOutputPath)Shoko.BuildTools.ManifestInfo.cs"
                        PluginID="$(PluginID)"
                        PluginName="$(PluginName)"
                        PluginOverview="$(PluginOverview)"
                        PluginTags="$(PluginTags)"
                        PluginDependencies="$(PluginDependencies)"
                        PluginDependencyItems="@(PluginDependency)" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Shoko.BuildTools.ManifestInfo.cs" />
    </ItemGroup>
  </Target>

  <!-- Source-based identity — fallback when no manifest.json exists -->
  <Target Name="_ShokoReadPluginIdentityFromSource" BeforeTargets="CoreGenerateAssemblyInfo" DependsOnTargets="$(ShokoBuildToolsPrepareTargets)"
          Condition="'$(ShokoBuildAssemblyInfoFile)' == '' And !Exists('$(MSBuildProjectDirectory)\manifest.json') And !Exists('$(MSBuildProjectDirectory)\..\manifest.json')">
    <ReadPluginIdentityFromSource ProjectDir="$(MSBuildProjectDirectory)"
                                  OutputPath="$(IntermediateOutputPath)Shoko.BuildTools.PluginIdentity.cs"
                                  NuGetPackageRoot="$(NuGetPackageRoot)"
                                  ReferencePaths="@(ReferencePath)"
                                  PluginID="$(PluginID)"
                                  PluginName="$(PluginName)"
                                  PluginOverview="$(PluginOverview)"
                                  PluginTags="$(PluginTags)"
                                  PluginDependencies="$(PluginDependencies)"
                        PluginDependencyItems="@(PluginDependency)" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Shoko.BuildTools.PluginIdentity.cs" Condition="Exists('$(IntermediateOutputPath)Shoko.BuildTools.PluginIdentity.cs')" />
    </ItemGroup>
  </Target>

  <!-- Generated plugin class — the IPlugin class, from the project's Plugin* properties -->
  <PropertyGroup>
    <PluginClassName Condition="'$(PluginClassName)' == ''">Plugin</PluginClassName>
  </PropertyGroup>

  <Target Name="_ShokoGeneratePluginClass" BeforeTargets="CoreGenerateAssemblyInfo" DependsOnTargets="$(ShokoBuildToolsPrepareTargets)"
          Condition="'$(PluginGenerateClass)' == 'true'">
    <GeneratePluginClass OutputPath="$(IntermediateOutputPath)Shoko.BuildTools.PluginClass.cs"
                         Namespace="$(RootNamespace)"
                         ClassName="$(PluginClassName)" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Shoko.BuildTools.PluginClass.cs" />
    </ItemGroup>
  </Target>

  <!-- Plugin images — embedded under names rooted in the assembly, which the server reads from the stamped metadata -->
  <Target Name="_ShokoEmbedPluginImages" BeforeTargets="PrepareForBuild"
          Condition="'$(PluginIcon)' != '' or '$(PluginThumbnail)' != ''">
    <PropertyGroup>
      <_ShokoPluginIconResource Condition="'$(PluginIcon)' != ''">$(AssemblyName).PluginIcon$([System.IO.Path]::GetExtension('$(PluginIcon)'))</_ShokoPluginIconResource>
      <_ShokoPluginThumbnailResource Condition="'$(PluginThumbnail)' != ''">$(AssemblyName).PluginThumbnail$([System.IO.Path]::GetExtension('$(PluginThumbnail)'))</_ShokoPluginThumbnailResource>
    </PropertyGroup>
    <Error Condition="'$(PluginIcon)' != '' and !Exists('$(PluginIcon)')" Text="PluginIcon '$(PluginIcon)' does not exist." />
    <Error Condition="'$(PluginThumbnail)' != '' and !Exists('$(PluginThumbnail)')" Text="PluginThumbnail '$(PluginThumbnail)' does not exist." />
    <ItemGroup>
      <EmbeddedResource Include="$(PluginIcon)" LogicalName="$(_ShokoPluginIconResource)" Condition="'$(PluginIcon)' != ''" />
      <AssemblyMetadata Include="PackageIcon" Value="$(_ShokoPluginIconResource)" Condition="'$(PluginIcon)' != ''" />
      <EmbeddedResource Include="$(PluginThumbnail)" LogicalName="$(_ShokoPluginThumbnailResource)" Condition="'$(PluginThumbnail)' != ''" />
      <AssemblyMetadata Include="PackageThumbnail" Value="$(_ShokoPluginThumbnailResource)" Condition="'$(PluginThumbnail)' != ''" />
    </ItemGroup>
  </Target>

  <!-- Release channel -->
  <Target Name="_ShokoAppendReleaseChannel" BeforeTargets="CoreGenerateAssemblyInfo" DependsOnTargets="$(ShokoBuildToolsPrepareTargets)">
    <AppendReleaseChannel ProjectDir="$(MSBuildProjectDirectory)"
                          OutputPath="$(IntermediateOutputPath)Shoko.BuildTools.AppendReleaseChannel.cs"
                          ReleaseChannel="$(ReleaseChannel)" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Shoko.BuildTools.AppendReleaseChannel.cs" Condition="Exists('$(IntermediateOutputPath)Shoko.BuildTools.AppendReleaseChannel.cs')" />
    </ItemGroup>
  </Target>

  <!-- Git metadata — C# task runs git and writes .cs file -->
  <Target Name="_ShokoStampGitMetadata" BeforeTargets="CoreGenerateAssemblyInfo" DependsOnTargets="$(ShokoBuildToolsPrepareTargets)"
          Condition="'$(ShokoBuildAssemblyInfoFile)' == ''">
    <StampGitMetadata ProjectDir="$(MSBuildProjectDirectory)"
                      OutputPath="$(IntermediateOutputPath)Shoko.BuildTools.GitInfo.cs" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Shoko.BuildTools.GitInfo.cs" />
    </ItemGroup>
  </Target>

</Project>

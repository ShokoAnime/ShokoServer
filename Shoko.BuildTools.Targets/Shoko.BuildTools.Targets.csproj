<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.4.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Shoko.BuildTools.Tasks</AssemblyName>
    <RootNamespace>Shoko.BuildTools.Tasks</RootNamespace>
    <PackageId>Shoko.BuildTools.Targets</PackageId>
    <Description>MSBuild targets and tasks for Shoko plugin builds. Stamps assembly metadata: the plugin's identity from its manifest.json or its source, the runtime identifier, the release channel, and the git revision, tag and date it was built from.</Description>
    <Authors>Shoko Team</Authors>
    <PackageProjectUrl>https://shokoanime.com</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ShokoAnime/ShokoServer</RepositoryUrl>
    <PackageTags>plugins, shoko, anime, msbuild, build</PackageTags>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <!-- Roslyn goes next to the tasks, in the output and the package, so MSBuild loads that copy instead
         of falling back to the SDK's, which a host such as shoko-build may have bound to another version. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);_ShokoPackTaskDependencies</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET.md" Pack="true" PackagePath="/README.md" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\Shoko.BuildTools.Targets.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="18.9.6" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.9.6" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Packs the assemblies copied next to the tasks, without their satellite resources. -->
  <Target Name="_ShokoPackTaskDependencies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.AssetType)' == 'runtime'" />
    </ItemGroup>
  </Target>

</Project>
